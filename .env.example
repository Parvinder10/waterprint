# ==========================================
# WATERPRINT Platform Environment Variables
# ==========================================

# Frontend Environment Variables (Vercel)
# URL of the hosted FastAPI analytics backend service
VITE_API_BASE_URL=https://your-waterprint-backend.com

# Backend Environment Variables (Railway / Render / Docker / AWS)
# Server port
PORT=8000

# Allowed CORS Origins (comma-separated)
# Include your Vercel deployment domain and preview domains
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app,https://vercel.com
